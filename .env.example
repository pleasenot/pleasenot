# Solana Meme Bot 配置模板
# 复制此文件为 .env 并填入你的 API Key

# === XXYY API Keys（多 key 分流，提高成交率）===
# 主 key（必需）从 https://www.xxyy.io/apikey 获取
XXYY_API_KEY=xxyy_ak_你的主key

# 可选：多 key 分流（建议申请 5 个 key）
# XXYY_API_KEY_SWAP=xxyy_ak_swap专用key
# XXYY_API_KEY_SWAP2=xxyy_ak_swap备用key
# XXYY_API_KEY_SCANNER=xxyy_ak_扫描器key
# XXYY_API_KEY_ANALYZER=xxyy_ak_分析器key
# XXYY_API_KEY_MONITOR=xxyy_ak_监控key

# === 基础配置 ===
XXYY_API_BASE_URL=https://www.xxyy.io
DEFAULT_CHAIN=sol
WALLET_ADDRESS=你的XXYY_Solana钱包地址
BUY_AMOUNT=0.03

# === BSC 链（可选，配了就启用双链扫描）===
# BSC_WALLET_ADDRESS=你的XXYY_BSC钱包地址
# BSC_BUY_AMOUNT=0.001
ANALYZER_MIN_SCORE=40

# === MiniMax AI（推荐，提升评分精度）===
# MINIMAX_API_KEY=你的MiniMax_API_Key
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# === Twitter（可选）===
# TWITTER_BEARER_TOKEN=你的Twitter_Bearer_Token
